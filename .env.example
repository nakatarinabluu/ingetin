# --- 1. PROJECT & SERVER CONFIG ---
PROJECT_NAME=ingetin
NODE_ENV=development
PORT=4000
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_HERE

# --- 2. INFRASTRUCTURE (Database & Redis) ---
# DATABASE_URL: Use 'localhost' for local terminal, 'ingetin-db' for Docker
POSTGRES_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
REDIS_URL=redis://default:PASSWORD@HOST:6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE

# --- 3. CLOUDFLARE TUNNEL (Public Access) ---
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_from_cloudflare_dashboard

# --- 4. WHATSAPP INTEGRATION ---
WA_BUSINESS_ACCOUNT_ID=your_whatsapp_business_id
WA_VERIFY_TOKEN=your_secret_verify_token_for_meta
WA_APP_SECRET=your_meta_app_secret

# WhatsApp 1: OTP Service
WA_OTP_PHONE_NUMBER_ID=your_phone_id_for_otp
WA_OTP_ACCESS_TOKEN=your_long_lived_access_token_for_otp

# WhatsApp 2: Notifications & Bot
WA_NOTIF_PHONE_NUMBER_ID=your_phone_id_for_notif
WA_NOTIF_ACCESS_TOKEN=your_long_lived_access_token_for_notif

# --- 5. AI & EXTERNAL INTEGRATIONS ---
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (For Calendar Sync)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# --- 6. SECURITY & CORS ---
JWT_SECRET=your_main_jwt_secret
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
ENCRYPTION_SECRET=your_64_char_hex_encryption_secret

# App URLs
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Other
MY_PERSONAL_PHONE=62...
DB_RETENTION_DAYS=30

# Optional observability
SENTRY_DSN=
VITE_SENTRY_DSN=

# Web development
VITE_USE_MOCK=false
